LOGSTORE_ENV=production
LOGSTORE_HOST=0.0.0.0
LOGSTORE_PORT=5000
LOGSTORE_PATH=/app/data/webdb
LOGSTORE_BACKUP_PATH=/app/data/backups
LOGSTORE_STATE_PATH=/app/data/.logstore-state.json
LOGSTORE_PUBLISHED_PORT=5000
LOGSTORE_SECRET_KEY=
LOGSTORE_INGEST_TOKEN=
# Optional multi-producer alternative to LOGSTORE_INGEST_TOKEN (JSON object).
# Example: LOGSTORE_INGEST_TOKENS={"checkout-service":"replace-with-a-random-secret"}
LOGSTORE_RETENTION_HOURS=0
LOGSTORE_RETENTION_INTERVAL_SECONDS=3600
LOGSTORE_BACKUP_RETENTION_COUNT=0
LOGSTORE_COOKIE_SECURE=false
